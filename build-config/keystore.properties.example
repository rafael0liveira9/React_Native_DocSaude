# Modelo do arquivo de credenciais do keystore Android.
#
# Copie para keystore.properties na RAIZ do projeto (ignorado pelo git) e preencha.
# Nao coloque em android/: o `expo prebuild --clean` apaga essa pasta inteira.
# Como a pasta android/ é regenerada pelo `expo prebuild --clean`, guarde uma
# cópia deste arquivo e do .jks FORA do projeto — o padrão é ~/.totaldoc-keys/.
#
#   mkdir -p ~/.totaldoc-keys
#   cp meu-keystore.jks ~/.totaldoc-keys/
#   cp build-config/keystore.properties.example keystore.properties
#
# Alternativa sem arquivo (CI): exporte TOTALDOC_KEYSTORE_FILE,
# TOTALDOC_KEYSTORE_PASSWORD, TOTALDOC_KEY_ALIAS e TOTALDOC_KEY_PASSWORD.

storeFile=/Users/SEU_USUARIO/.totaldoc-keys/totaldoc-upload.jks
storePassword=COLE_A_SENHA_DO_KEYSTORE
keyAlias=COLE_O_ALIAS
keyPassword=COLE_A_SENHA_DA_CHAVE
